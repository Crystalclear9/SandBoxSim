{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SandBoxSim evaluation request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "default": "sample"
    },
    "seed": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "default": 839102
    },
    "agents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 40
    },
    "previewDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "default": 0
    },
    "panel": {
      "type": "string",
      "enum": [
        "field",
        "person",
        "person-hands",
        "architecture",
        "characters",
        "model-details",
        "ecology-details",
        "wardrobe",
        "faces",
        "equipment",
        "actions",
        "hands",
        "naturemodels",
        "trails",
        "homes",
        "farms"
      ],
      "default": "field"
    },
    "warmupFrames": {
      "type": "integer",
      "minimum": 3,
      "maximum": 3600,
      "default": 60
    },
    "measuredFrames": {
      "type": "integer",
      "minimum": 2,
      "maximum": 36000,
      "default": 120
    },
    "ticksPerFrame": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "default": 0
    },
    "minimumFps": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "default": 0
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "default": "runs/evaluation"
    },
    "captureFrames": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 3
      },
      "default": []
    },
    "commands": {
      "type": "array",
      "maxItems": 4096,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 3
          },
          "command": {
            "type": "string",
            "enum": [
              "journal.open",
              "settings.open",
              "escape",
              "portrait.face",
              "portrait.hands",
              "portrait.body",
              "portrait.drag",
              "portrait.zoom",
              "portrait.reset",
              "world.view",
              "home.focus",
              "home.resident"
            ]
          },
          "value": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "frame",
          "command"
        ]
      }
    }
  },
  "description": "Defaults match the engine. Frame upper bounds, panel dependencies and command values are validated by the engine."
}
