{
  "schemaVersion": 1,
  "transport": "local-cli-files-and-loopback-http",
  "commands": [
    "run",
    "verify",
    "score",
    "compare",
    "describe"
  ],
  "capabilities": {
    "fixedStepSimulation": true,
    "renderTiming": true,
    "visualSamples": true,
    "semanticUiReplay": true,
    "visionPredictionScoring": true,
    "liveStepApi": true,
    "httpService": true,
    "automaticModelInvocation": false,
    "validatedRsiBenchmark": false,
    "pairedEfficiencyBenchmark": true,
    "rsiEfficiencyEvidenceValidation": true,
    "agentSelfEditExecution": true,
    "improverMechanismIntervention": true,
    "offspringYieldEvaluation": true,
    "costSensitiveImproverAnalysis": true,
    "retrospectiveBudgetCurves": true,
    "codeDeploymentPaybackEstimate": true,
    "realSandboxSourceResearch": true,
    "controllerBuildsAndTestsCandidates": true,
    "automaticCandidateAdoption": false,
    "frozenRealSourceResearchComparison": true,
    "renderBuildSourceIdentity": true
  },
  "schemas": {
    "request": "request.schema.json",
    "predictions": "predictions.schema.json",
    "result": "result.schema.json",
    "online": "online.openapi.json",
    "rsiRounds": "rsi-rounds.schema.json",
    "rsiMeta": "rsi-meta.schema.json"
  },
  "exitCodes": {
    "0": "completed",
    "1": "performance threshold not met",
    "2": "invalid input, incompatible comparison, engine or artifact error",
    "124": "run timed out"
  },
  "requiredEnvironment": {
    "python": "3.10+",
    "dotnet": 8,
    "godotDotnet": "4.7.2"
  },
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "outputEncoding": "UTF-8",
  "errors": "Use --json-errors before the subcommand for JSON on stderr.",
  "online": {
    "protocol": "sandboxsim-step-v1",
    "bind": "127.0.0.1",
    "authentication": "SANDBOXSIM_API_TOKEN bearer",
    "launcher": "tools/online.py",
    "benchmark": "tools/efficiency.py",
    "visualObservation": false,
    "rsiValidationScope": "Agent capability transfer, executed self-edit lineage, paired offspring yields and improve-method reversion; runtime acceleration remains separately measured."
  },
  "metaBenchmark": {
    "entry": "tools/rsi_benchmark.py",
    "schemaVersion": 2,
    "agentAbi": [
      "propose(request)",
      "improve(request)"
    ],
    "backends": [
      "kernel",
      "code",
      "http"
    ],
    "trustedLocalExecutionOnly": true,
    "generalRsiProof": false,
    "taskSuites": [
      "algorithm-v1",
      "sandbox-stream-v1"
    ],
    "retention": "sandbox-stream-v1 stages after the first re-probe every earlier curriculum phase with fresh private tasks; per-family non-regression gates recursive evidence",
    "report": "verified self-contained HTML: tools/rsi_benchmark.py report <folder> --output <file>",
    "costStudy": {
      "entry": "tools/rsi_efficiency_study.py",
      "outputKind": "rsi-cost-study-v1",
      "verifiedArchiveRequired": true,
      "completeCostLedger": false,
      "budgetAwarePolicyRerun": false,
      "generalRsiProof": false
    }
  },
  "sourceResearch": {
    "protocol": "real-sandbox-research-v1",
    "entry": "tools/sandbox_research.py",
    "commands": [
      "run",
      "verify"
    ],
    "report": "tools/sandbox_research_report.py",
    "sourceScope": "Existing explicitly allowed Core C# files in independent snapshots",
    "environment": "Python 3.10+, Git and .NET 8 SDK",
    "automaticModelInvocation": false,
    "recursiveEvidenceClaim": false,
    "osIsolation": false
  }
}
