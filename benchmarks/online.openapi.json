{
  "openapi": "3.1.0",
  "info": {
    "title": "SandBoxSim online fixed-tick API",
    "version": "1.1.0",
    "description": "Loopback only, no renderer. Origin headers rejected. Step validation is atomic; engine failures fault the session. Retries require identical JSON payloads. Request bodies must be valid UTF-8; query parameters are rejected. Retry IDs are bound to the operation and exact JSON payload within a 64-reply window."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Runtime and binary identity",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "Protocol limits and machine identity",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "summary": "Create a caller-driven world",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Create"
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{sessionId}": {
      "get": {
        "summary": "Pure world observation",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Observation"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ]
      },
      "delete": {
        "summary": "Release a session",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ]
      }
    },
    "/v1/sessions/{sessionId}/step": {
      "post": {
        "summary": "Apply validated actions and advance exact ticks; idempotent requestId",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Step"
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/reset": {
      "post": {
        "summary": "Reset world; increment revision without resetting version counter",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Observation"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reset"
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/map": {
      "get": {
        "summary": "Row-major traversal grid including elevation, footTraffic and vegetation; traversalHeight retains the Temperature traversal proxy",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ]
      }
    },
    "/v1/sessions/{sessionId}/path": {
      "post": {
        "summary": "Batch A-star paths without advancing world; failures can reflect search budget",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Paths"
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/inspect": {
      "post": {
        "summary": "Inspect a revision-checked page of residents or buildings without advancing the world",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityPage"
                }
              }
            }
          },
          "default": {
            "description": "Structured error (400/401/403/404/408/409/413/429/500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Inspect"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seed"
        ],
        "properties": {
          "seed": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "width": {
            "type": "integer",
            "minimum": 16,
            "maximum": 128
          },
          "height": {
            "type": "integer",
            "minimum": 16,
            "maximum": 128
          },
          "agents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          }
        }
      },
      "Reset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision",
          "seed"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "seed": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "width": {
            "type": "integer",
            "minimum": 16,
            "maximum": 128
          },
          "height": {
            "type": "integer",
            "minimum": 16,
            "maximum": 128
          },
          "agents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          }
        }
      },
      "Action": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "x",
              "y",
              "terrain"
            ],
            "properties": {
              "kind": {
                "const": "terrain"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "terrain": {
                "enum": [
                  "Grass",
                  "Forest",
                  "Water",
                  "Mountain",
                  "Sand",
                  "Farmland",
                  "Road",
                  "Snow",
                  "Swamp",
                  "Desert",
                  "Lava"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "x",
              "y",
              "resource",
              "amount"
            ],
            "properties": {
              "kind": {
                "const": "resource"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "resource": {
                "enum": [
                  "Food",
                  "Wood",
                  "Stone",
                  "Iron"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "x",
              "y",
              "radius",
              "delta"
            ],
            "properties": {
              "kind": {
                "const": "fertility"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "radius": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "delta": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          }
        ]
      },
      "Step": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision",
          "ticks"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "ticks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "actions": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          }
        }
      },
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "goalX",
          "goalY"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "goalX": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "goalY": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          }
        }
      },
      "Paths": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedRevision",
          "queries"
        ],
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/Query"
            }
          }
        }
      },
      "Observation": {
        "type": "object",
        "required": [
          "revision",
          "tick",
          "digest",
          "episode"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "digest": {
            "type": "string"
          },
          "faulted": {
            "type": "boolean"
          },
          "population": {
            "type": "integer"
          },
          "food": {
            "type": "number"
          },
          "wood": {
            "type": "number"
          },
          "stone": {
            "type": "number"
          },
          "buildings": {
            "type": "integer"
          },
          "episode": {
            "type": "object",
            "required": [
              "epoch",
              "stepCalls",
              "ticks",
              "actions"
            ],
            "properties": {
              "epoch": {
                "type": "integer",
                "minimum": 0
              },
              "stepCalls": {
                "type": "integer",
                "minimum": 0
              },
              "ticks": {
                "type": "integer",
                "minimum": 0
              },
              "actions": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Inspect": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedRevision",
          "kind"
        ],
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "enum": [
              "agents",
              "buildings"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128,
            "default": 32
          }
        }
      },
      "EntityPage": {
        "type": "object",
        "required": [
          "schemaVersion",
          "revision",
          "epoch",
          "tick",
          "digest",
          "kind",
          "offset",
          "limit",
          "total",
          "nextOffset",
          "items"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 0
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          },
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "digest": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "agents",
              "buildings"
            ]
          },
          "nextOffset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "items": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/AgentEntity"
                },
                {
                  "$ref": "#/components/schemas/BuildingEntity"
                }
              ]
            }
          }
        }
      },
      "AgentEntity": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "description": "Session-scoped epoch:kind:slot:generation. Reset changes epoch; slot reuse changes generation."
          },
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "lifeStage": {
            "type": "string"
          },
          "job": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "ageDays": {
            "type": "number"
          },
          "health": {
            "type": "number"
          },
          "hunger": {
            "type": "number"
          },
          "thirst": {
            "type": "number"
          },
          "fatigue": {
            "type": "number"
          },
          "food": {
            "type": "number"
          }
        },
        "required": [
          "entityId",
          "slot",
          "generation",
          "x",
          "y",
          "ageDays",
          "lifeStage",
          "job",
          "state",
          "action",
          "phase",
          "health",
          "hunger",
          "thirst",
          "fatigue",
          "food"
        ]
      },
      "BuildingEntity": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "description": "Session-scoped epoch:kind:slot:generation. Reset changes epoch; slot reuse changes generation."
          },
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "progress": {
            "type": "number"
          },
          "condition": {
            "type": "number",
            "description": "Structural integrity, 1 healthy and 0 destroyed."
          },
          "occupiedBeds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "entityId",
          "slot",
          "generation",
          "x",
          "y",
          "kind",
          "state",
          "progress",
          "condition",
          "occupiedBeds"
        ]
      }
    }
  }
}
