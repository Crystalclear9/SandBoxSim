{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent improver benchmark v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agent",
    "budget"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "backend": {
      "enum": [
        "kernel",
        "code",
        "http"
      ],
      "default": "kernel"
    },
    "stages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "probeTasks": {
      "type": "integer",
      "minimum": 12,
      "maximum": 60,
      "multipleOf": 3
    },
    "forkReplicates": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "effectMargin": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.5
    },
    "envAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "callSeconds",
        "taskSeconds"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "callSeconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120
        },
        "taskSeconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 600
        }
      }
    },
    "httpStages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "training",
          "probes"
        ],
        "properties": {
          "training": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "reference",
                "description",
                "developmentSuite",
                "heldoutSuite"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "developmentSuite": {
                  "type": "string",
                  "minLength": 1
                },
                "heldoutSuite": {
                  "type": "string",
                  "minLength": 1
                },
                "workspace": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "probes": {
            "type": "array",
            "minItems": 12,
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "reference",
                "description",
                "developmentSuite",
                "heldoutSuite"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "developmentSuite": {
                  "type": "string",
                  "minLength": 1
                },
                "heldoutSuite": {
                  "type": "string",
                  "minLength": 1
                },
                "workspace": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "taskSuite": {
      "enum": [
        "algorithm-v1",
        "sandbox-stream-v1"
      ],
      "default": "algorithm-v1"
    },
    "workloadScale": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "backend"
        ],
        "properties": {
          "backend": {
            "const": "http"
          }
        }
      },
      "then": {
        "required": [
          "httpStages"
        ]
      }
    },
    {
      "if": {
        "required": [
          "taskSuite"
        ],
        "properties": {
          "taskSuite": {
            "const": "sandbox-stream-v1"
          }
        }
      },
      "then": {
        "required": [
          "backend"
        ],
        "properties": {
          "backend": {
            "const": "code"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "workloadScale"
        ],
        "properties": {
          "workloadScale": {
            "minimum": 2
          }
        }
      },
      "then": {
        "required": [
          "taskSuite"
        ],
        "properties": {
          "taskSuite": {
            "const": "sandbox-stream-v1"
          }
        }
      }
    }
  ]
}
