{
  "$comment": "SandBoxSim 默认模拟参数。所有改动都会改变涌现行为，改前请读 docs/15-ConfigReference.md。",
  "version": 1,

  "clock": {
    "$comment": "1 Tick = 1 游戏分钟。1440 tick = 1 游戏天。",
    "minutesPerTick": 1,
    "ticksPerHour": 60,
    "hoursPerDay": 24,
    "ticksPerSecondAt1x": 10,
    "$comment_speeds": "倍速只改变每秒步数，绝不改变 tick 语义（第 82 条）。",
    "speedMultipliers": [0, 1, 2, 4, 8],
    "targetFramesPerSecond": 60,
    "maxCatchUpTicksPerFrame": 40
  },

  "world": {
    "$comment": "M0 世界尺寸。后续可通过 worldgen 配置放大，但 100x100 是 MVP 基线。",
    "width": 100,
    "height": 100,
    "chunkSize": 16,
    "ambientTemperature": 0.55,
    "ambientMoisture": 0.5
  },

  "worldgen": {
    "$comment": "Perlin + fBm。同 seed + 同参数 => 逐像素一致（验收标准 2）。",
    "seed": 839102,
    "continentFrequency": 0.018,
    "continentOctaves": 4,
    "continentPersistence": 0.5,
    "moistureFrequency": 0.035,
    "moistureOctaves": 3,
    "moisturePersistence": 0.55,
    "detailFrequency": 0.12,
    "$comment_levels": "waterLevel / mountainLevel 是'水面与山地的目标占比'（格子比例）。世界生成按分位数取阈值，因此小地图也一定有水有山；jitter 让不同 seed 的海陆比例有差异。",
    "waterLevel": 0.28,
    "mountainLevel": 0.16,
    "waterShareJitter": 0.10,
    "mountainShareJitter": 0.07,
    "sandBand": 0.035,
    "forestMoistureThreshold": 0.52,
    "forestDensityBonus": 0.18,
    "fertilityFromHeight": true,
    "fertilityBase": 0.55,
    "fertilityNoiseFrequency": 0.06
  },

  "resources": {
    "$comment": "第 62/63 条：R_{t+1} = clamp(R_t + Regen - Harvest, 0, K)；再生用离散 Logistic。",
    "woodCapacityPerForestTile": 100.0,
    "woodInitialFraction": 0.85,
    "woodGrowthRate": 0.02,
    "woodHarvestPerAction": 6.0,
    "stoneCapacityPerMountainTile": 80.0,
    "stoneInitialFraction": 0.9,
    "stoneHarvestPerAction": 4.0,
    "ironCapacityPerMountainTile": 30.0,
    "ironInitialFraction": 0.6,
    "ironHarvestPerAction": 2.0,
    "foodCapacityPerGrassTile": 60.0,
    "foodInitialFraction": 0.6,
    "foodGrowthRate": 0.03,
    "foodHarvestPerAction": 24.0,
    "regenerateHourly": true,
    "depletionWarnFraction": 0.2
  },

  "needs": {
    "$comment": "需求速率单位为'每天增加多少'。1.0 表示不吃不喝一整天才会从满足到极端。想快速验证饥荒场景，把 hungerPerDay 调到 5 以上即可。",
    "hungerPerDay": 1.0,
    "fatiguePerDay": 1.15,
    "thirstPerDay": 1.5,
    "socialPerDay": 0.5,
    "sleepRecoveryPerDay": 1.45,
    "starvationDamageThreshold": 0.85,
    "starvationDamagePerDay": 0.25,
    "dehydrationDamageThreshold": 0.9,
    "dehydrationDamagePerDay": 0.45,
    "healthRecoveryPerDay": 0.1,
    "adulthoodDays": 16,
    "elderDays": 55,
    "elderMortalityPerDay": 0.012,
    "maxLifespanDays": 90
  },

  "ai": {
    "$comment": "Utility AI 参数。改这些值就是在改'什么行为在什么时候更值得做'，是项目最需要实验的部分。",
    "decisionIntervalTicks": 600,
    "batchCount": 0,
    "targetDecisionsPerTick": 12,
    "searchRadius": 12,
    "wanderRadius": 6,
    "exploreMinDistance": 15,
    "exploreMaxDistance": 40,
    "topScoresToKeep": 6,
    "moveSpeedPerTick": 0.35,
    "wanderWeight": 0.18,
    "exploreWeight": 0.22,
    "eatHungerWeight": 2.0,
    "eatFoodAvailableWeight": 1.2,
    "drinkThirstWeight": 2.2,
    "sleepFatigueWeight": 2.0,
    "sleepNightBonus": 0.6,
    "$comment_gather": "gatherFoodHungerWeight 必须显著大于木材/石料的可得性权重：否则'没木没石'的人会一直砍柴，快饿死也不去采食物（实测出现过 40 人全饿死且食物采集量为 0）。",
    "gatherFoodHungerWeight": 2.5,
    "gatherFoodAvailabilityWeight": 1.0,
    "gatherWoodNeedWeight": 1.4,
    "gatherOverstockWeight": 2.2,
    "gatherForBuildWeight": 2.6,
    "inventoryComfort": 45.0,
    "gatherWoodAvailabilityWeight": 1.2,
    "gatherStoneAvailabilityWeight": 1.0,
    "industriousnessWorkBonus": 0.55,
    "socializeWeight": 0.5,
    "homeAttachmentWeight": 0.35,
    "homeAttachmentRadius": 25.0,
    "blockedUtilityMultiplier": 0.15,
    "actionPatienceTicks": 900,
    "huntHungerWeight": 1.9,
    "huntAvailabilityWeight": 1.1,
    "depositSurplusWeight": 1.2,
    "depositPileBonusWeight": 0.8,
    "takeNeedWeight": 0.7,
    "takeAvailabilityWeight": 0.9
  },

  "wildlife": {
    "$comment": "野生动物（M2）。生态链：植被 -> 动物 -> 猎人产出。砍伐森林会减少栖息地，从而减少猎物 —— 这是'砍树的长期代价'的来源。",
    "moveSpeedPerTick": 0.5,
    "foodPerKill": 30.0,
    "reproductionChancePerDay": 0.30,
    "naturalDeathChancePerDay": 0.02,
    "capacityPerVegetationTile": 0.05,
    "initialPopulationCap": 120,
    "fleeRadius": 6,
    "huntRange": 1,
    "huntTicks": 12,
    "animalSenseRadius": 8
  },

  "migration": {
    "$comment": "迁移（M2 简化版）：只做'个体离开原住地'，不做'建立新聚落'（M7）。机会不是随机的，而是沿八个方向探出去比较资源密度。",
    "threshold": 0.62,
    "scarcityGate": 0.55,
    "scarcityWeight": 1.0,
    "hungerWeight": 0.8,
    "housingWeight": 0.4,
    "dangerWeight": 0.6,
    "populationPressureWeight": 0.5,
    "nearbyOpportunityWeight": 0.9,
    "homeAttachmentWeight": 1.1,
    "minDistance": 25,
    "maxDistance": 60,
    "homeRegionRadius": 18,
    "cooldownDays": 8.0,
    "probeDirections": 8,
    "probeDistance": 45
  },

  "groundStocks": {
    "$comment": "地面物资堆（M2）：让'攒物资'在空间上可见，是 M3 共享仓库的前身。",
    "capacityPerKind": 400.0,
    "surplusThreshold": 70.0,
    "dropAmount": 10.0,
    "takeNeedThreshold": 6.0,
    "takeAmount": 15.0,
    "searchRadius": 18
  },

  "buildings": {
    "$comment": "建造（M3）。造价与产能写在 BuildingRegistry.cs 里（配方数据），这里只放行为参数：施工速度、选址半径、效用权重。",
    "workPerFastTick": 8,
    "siteSearchRadius": 14,
    "storageSearchRadius": 24,
    "buildMaterialWeight": 1.1,
    "buildGapWeight": 1.6,
    "buildSiteWeight": 0.7,

    "$comment_decay": "M4：无人维护的建筑会衰减。没有它，建筑只会单调增加，饱和点只是掩盖了问题。",
    "decayPerDay": 0.012,
    "decayGraceDays": 3.0,
    "demolishWhenDecayed": true,

    "$comment_farm": "M4：农业产出。产量 = 基础 x 地力 x 湿度 x 天气 x 劳动力。FarmUnattendedFactor 让'有田但没人种'与'有人种'可区分。",
    "farmBaseYieldPerDay": 16.0,
    "farmLaborBonusMax": 0.6,
    "farmUnattendedFactor": 0.25,
    "farmWorkPerAction": 1.0,
    "farmLaborPerDayCap": 3.0,
    "farmBadWeatherFactor": 0.45
  },

  "birth": {
    "$comment": "出生（M4）。这是这个世界唯一缺失的机制：没有出生，人口单调降到 0。三条阻尼缺一不可 —— 食物、床位（硬门）、健康，再加人口压力提供负反馈。",
    "baseChancePerDay": 0.20,
    "maxChancePerDay": 0.30,
    "pairRadius": 8.0,
    "minDaysBetweenBirths": 6.0,
    "healthCostPerBirth": 0.08,
    "foodPerCapitaTarget": 30.0,
    "foodFactorFloor": 0.15,
    "popPressureScale": 0.50,
    "mutationScale": 0.08
  },

  "debug": {
    "logDecisions": false,
    "stateHashEveryTicks": 1440,
    "assertInvariants": true
  }
}
