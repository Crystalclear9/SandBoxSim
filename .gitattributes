# 统一换行与文本处理，避免跨平台 diff 噪音
* text=auto eol=lf

*.cs        text diff=csharp
*.csproj    text diff=xml
*.props     text diff=xml
*.targets   text diff=xml
*.sln       text eol=crlf
*.json      text diff=json
*.md        text diff=markdown
*.ps1       text eol=crlf
*.yml       text
*.yaml      text

# 二进制
*.png       binary
*.ttf       binary
*.dll       binary
*.exe       binary
*.simsave   binary

# 保留上游授权原文及其校验值（原文含行尾空格）
src/SandBoxSim.Godot/assets/fonts/*-OFL.txt whitespace=-blank-at-eol

# 语系统计：不要在生成文件上统计语言占比
bin/**      linguist-vendored
obj/**      linguist-vendored
.tools/**   linguist-vendored
