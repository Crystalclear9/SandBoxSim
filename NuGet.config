<?xml version="1.0" encoding="utf-8"?>
<!--
  SandBoxSim 的 NuGet 配置：**刻意清空所有包源**。

  理由：
    1. 本仓库不依赖任何 NuGet 包（测试框架、JSON、PNG/zlib 全部自带实现，
       见 docs/12-Milestones.md 的构建通道说明），所以不需要任何远程源；
    2. `dotnet restore` 在无法访问 nuget.org 的环境（离线机、受限网络、CI 沙箱）中
       会因为"找不到源"而**静默失败**：输出是"生成失败 / 0 个错误"，没有任何错误行，
       极难排查。清空源之后，restore 变成纯本地操作，离线也能成功。
    3. 这也顺带保证了构建不会因为上游包源故障而挂掉。

  如果未来确实需要引入包，请在这里加回一个明确的源，并在 docs 里记录理由。
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
