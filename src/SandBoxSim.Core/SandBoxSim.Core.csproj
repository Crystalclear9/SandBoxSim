<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SandBoxSim.Core —— 纯模拟内核。
    硬性约束（由 docs/13 与 tests/DeterminismTests 保证）：
      1. 不引用任何平台/UI/IO 库（不使用 System.Console、System.IO、System.Drawing）。
      2. 不读取时钟（不使用 DateTime.Now / Environment.TickCount / Stopwatch）。
      3. 不直接使用 System.Random，统一走 Foundation/DeterministicRandom。
      4. 不依赖字典/哈希集合的迭代顺序，所有迭代走索引数组。
    任何表现层需求都必须通过 Simulation 暴露的只读查询接口获得。
  -->
  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>SandBoxSim Core Simulation</AssemblyTitle>
  </PropertyGroup>

</Project>
