<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SandBoxSim.Core —— 纯模拟内核。
    硬性约束（由 docs/13 与 tests/DeterminismTests 保证）：
      1. 不引用任何平台/UI/IO 库（不使用 System.Console、System.IO、System.Drawing）。
      2. 不读取时钟（不使用 DateTime.Now / Environment.TickCount / Stopwatch）。
      3. 不直接使用 System.Random，统一走 Foundation/DeterministicRandom。
      4. 不依赖字典/哈希集合的迭代顺序，所有迭代走索引数组。
    任何表现层需求都必须通过 Simulation 暴露的只读查询接口获得。
  -->
  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>SandBoxSim Core Simulation</AssemblyTitle>
  </PropertyGroup>

  <!--
    注意：InternalsVisibleTo 用**源码里的 assembly 特性**声明（见 CoreProperties.cs），
    而不是 MSBuild 的 <InternalsVisibleTo> 项。
    原因：MSBuild 那个项需要 SDK 生成 AssemblyInfo 才能生效，
    而本仓库的降级通道（Roslyn csc 直编）不走 SDK，于是测试程序集拿不到 internal 访问权 ——
    表现为"通道 A 测试全绿、通道 B 编译失败"，是双通道架构里最典型的坑。
    写成源码特性之后，两条通道行为完全一致。
  -->

</Project>
